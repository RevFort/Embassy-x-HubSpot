# --- Required -----------------------------------------------------------------
# HubSpot private app token. Scopes: crm.objects.contacts.read/write,
# crm.schemas.contacts.read (+ .write for `npm run setup:properties`), and if campaign attribution is
# enabled: crm.objects.custom.read/write, crm.schemas.custom.read.
HUBSPOT_ACCESS_TOKEN=
# OAuth client credentials the agency exchanges for an access token at POST /oauth2/token.
# Secret must be at least 32 chars, e.g. `openssl rand -hex 32`.
OAUTH_CLIENT_ID=e33233c62c29de80a4cc0e652bd02475884b4217ddd71a643f723fe3d9d48447
OAUTH_CLIENT_SECRET=b9e9707ee4ff4c88bf7cd5ffe4ab110c2ab3ac8b477b5dc8f7365daefa4028d1
# HMAC key that signs access tokens (at least 32 chars). Changing it invalidates every issued token.
TOKEN_SIGNING_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600

# --- Server ---------------------------------------------------------------------
PORT=8080
LOG_LEVEL=info

# --- Matching (duplicate contacts) ---------------------------------------------------
DEFAULT_COUNTRY_CODE=91
# Contact properties holding identifiers (searched for duplicates).
PROP_MOBILE=phone
PROP_ALTERNATE_MOBILE=mobilephone
PROP_EMAIL=email
PROP_ALTERNATE_EMAIL=alternate_email

# Computed contact properties (leave empty to disable).
PROP_RE_ENQUIRY_COUNT=re_enquiry_count
PROP_LAST_ENQUIRY_AT=last_enquiry_at
PROP_RAW_PAYLOAD=marketing_api_raw_payload

# --- Campaign attribution (SOP step 5) ---------------------------------------------
CAMPAIGN_ENABLED=false
CAMPAIGN_OBJECT_TYPE=
CAMPAIGN_ID_PROPERTY=sf_campaign_id
CAMPAIGN_MEMBER_OBJECT_TYPE=
CAMPAIGN_MEMBER_NAME_PROPERTY=name
CAMPAIGN_MEMBER_STATUS_PROPERTY=status
CAMPAIGN_MEMBER_STATUS_VALUE=Responded

CREATE_TASK_ON_RE_ENQUIRY=true

# --- Integration log (Integration_Logs__c equivalent) ------------------------------
INTEGRATION_LOG_DIR=./logs
INTEGRATION_LOG_INCLUDE_PAYLOAD=true
FIELD_MAPPING_PATH=./config/field-mapping.json
