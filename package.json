{
  "name": "embassy-marketing-lead-api",
  "version": "1.0.0",
  "private": true,
  "description": "Wrapper API between the marketing agency (Aurum) and HubSpot: de-duplicates incoming leads and creates or updates Contacts/Leads per the Lead Duplicate Handling SOP.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts | pino-pretty",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
